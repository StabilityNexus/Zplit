# Database Configuration
# Update with your PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zplit_db?schema=public"

# JWT Secret for token signing
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-jwt-secret-here-change-this"

# Admin Registration Invite Key (Optional)
# If set, allows creation of admin accounts via POST /auth/register-admin with this key
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, admin registration is disabled (only seed can create admins)
ADMIN_INVITE_KEY="your-secure-admin-invite-key-here"

# Server Configuration
PORT=4000
NODE_ENV=development

# Seed Configuration (Development Only)
# Optional: Provide explicit passwords for seed data
# If not set, random secure passwords will be generated for development
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="your-secure-admin-password"
# SEED_CLIENT_EMAIL="client@example.com"
# SEED_CLIENT_USER_EMAIL="clientuser@example.com"
# SEED_CLIENT_PASSWORD="your-secure-client-password"
